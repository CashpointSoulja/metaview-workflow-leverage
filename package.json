{
  "name": "metaview-workflow-leverage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Commercial Workflow Leverage Lab: an independent concept by Ayo Ahmed. Synthetic data only.",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vite build && vitest run",
    "evals": "node --experimental-strip-types eval/run.ts",
    "evals:broken": "node --experimental-strip-types eval/run.ts --variant=broken",
    "dryrun": "vite build && wrangler deploy --dry-run --outdir .wrangler/dryrun",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "axe-core": "^4.10.2",
    "playwright": "^1.48.2",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.0",
    "wrangler": "^4.150.0"
  }
}
