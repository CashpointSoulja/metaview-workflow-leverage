{
  // Cloudflare Workers Free. Prepared, not deployed. One SQLite-backed Durable Object per visitor.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metaview-workflow-leverage",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "VisitorWorkspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitorWorkspace"] }],
  "observability": { "enabled": false },
  "workers_dev": true
}
